-- ANIMACIÓN RGB
local hue = 0
local tick = 0
local rgbConnection = RunService.RenderStepped:Connect(function(dt)
    hue = (hue + dt * 0.4) % 1
    tick = tick + dt
    
    local currentColor = Color3.fromHSV(hue, 1, 1)
    rgbStroke.Color = currentColor
    creditLabel.TextColor3 = currentColor
    
    local pulse = (math.sin(tick * 5) + 1) / 2
    rgbStroke.Thickness = 1.5 + (pulse * 1.5)
end)

-- FUNCIONALIDAD DE CERRAR
closeButton.MouseButton1Click:Connect(function()
    closeSound:Play()
    if rgbConnection then rgbConnection:Disconnect() end
    
    local exitTween = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0)
    })
    
    exitTween:Play()
    exitTween.Completed:Connect(function()
        screenGui:Destroy()
    end)
end)

-- ARRASTRAR VENTANA
local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

local function updateDrag(input)
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

dragHitbox.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

dragHitbox.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateDrag(input)
    end
end)

